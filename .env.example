# Copy this file to .env and put your real keys there. .env is ignored by git - never commit it.
# You only need the key of the AI provider you use.

# Claude (Anthropic): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Gemini (Google): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: a fixed Gemini model; otherwise the dashboard lets you pick from the models your key can use (e.g. gemini-3.8-flash)
GEMINI_MODEL=
